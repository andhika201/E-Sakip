{
  "openapi": "3.0.3",
  "info": {
    "title": "API e-SAKIP Kabupaten Pringsewu",
    "version": "1.0.0",
    "description": "API read-only untuk perangkat daerah, IKU, cascading, dan pohon kinerja perangkat daerah."
  },
  "servers": [
    {
      "url": "/",
      "description": "Server aplikasi saat ini"
    }
  ],
  "security": [
    {
      "ApiToken": []
    }
  ],
  "tags": [
    {
      "name": "Perangkat Daerah"
    },
    {
      "name": "IKU"
    },
    {
      "name": "Cascading"
    },
    {
      "name": "Pohon Kinerja"
    }
  ],
  "paths": {
    "/api/perangkat-daerah": {
      "get": {
        "tags": ["Perangkat Daerah"],
        "summary": "Daftar perangkat daerah",
        "responses": {
          "200": {
            "description": "Daftar perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpdListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/perangkat-daerah/{opd_id}": {
      "get": {
        "tags": ["Perangkat Daerah"],
        "summary": "Detail perangkat daerah",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Detail perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpdResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/perangkat-daerah/{opd_id}/iku": {
      "get": {
        "tags": ["IKU"],
        "summary": "IKU perangkat daerah",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdPath"
          },
          {
            "$ref": "#/components/parameters/Periode"
          },
          {
            "$ref": "#/components/parameters/TahunMulai"
          },
          {
            "$ref": "#/components/parameters/TahunAkhir"
          },
          {
            "$ref": "#/components/parameters/StatusIku"
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar IKU perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IkuListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/perangkat-daerah/{opd_id}/cascading": {
      "get": {
        "tags": ["Cascading"],
        "summary": "Cascading perangkat daerah",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdPath"
          },
          {
            "$ref": "#/components/parameters/Periode"
          },
          {
            "$ref": "#/components/parameters/TahunMulai"
          },
          {
            "$ref": "#/components/parameters/TahunAkhir"
          }
        ],
        "responses": {
          "200": {
            "description": "Matriks cascading perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CascadingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/perangkat-daerah/{opd_id}/pohon-kinerja": {
      "get": {
        "tags": ["Pohon Kinerja"],
        "summary": "Pohon kinerja perangkat daerah",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdPath"
          },
          {
            "$ref": "#/components/parameters/Periode"
          },
          {
            "$ref": "#/components/parameters/TahunMulai"
          },
          {
            "$ref": "#/components/parameters/TahunAkhir"
          }
        ],
        "responses": {
          "200": {
            "description": "Tree pohon kinerja perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PohonKinerjaResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/iku": {
      "get": {
        "tags": ["IKU"],
        "summary": "IKU perangkat daerah menggunakan query opd_id",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdQuery"
          },
          {
            "$ref": "#/components/parameters/Periode"
          },
          {
            "$ref": "#/components/parameters/TahunMulai"
          },
          {
            "$ref": "#/components/parameters/TahunAkhir"
          },
          {
            "$ref": "#/components/parameters/StatusIku"
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar IKU perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IkuListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/cascading": {
      "get": {
        "tags": ["Cascading"],
        "summary": "Cascading perangkat daerah menggunakan query opd_id",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdQuery"
          },
          {
            "$ref": "#/components/parameters/Periode"
          },
          {
            "$ref": "#/components/parameters/TahunMulai"
          },
          {
            "$ref": "#/components/parameters/TahunAkhir"
          }
        ],
        "responses": {
          "200": {
            "description": "Matriks cascading perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CascadingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/pohon-kinerja": {
      "get": {
        "tags": ["Pohon Kinerja"],
        "summary": "Pohon kinerja perangkat daerah menggunakan query opd_id",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdQuery"
          },
          {
            "$ref": "#/components/parameters/Periode"
          },
          {
            "$ref": "#/components/parameters/TahunMulai"
          },
          {
            "$ref": "#/components/parameters/TahunAkhir"
          }
        ],
        "responses": {
          "200": {
            "description": "Tree pohon kinerja perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PohonKinerjaResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiToken": {
        "type": "apiKey",
        "in": "header",
        "name": "api-token",
        "description": "Masukkan token API dari file .env."
      }
    },
    "parameters": {
      "OpdIdPath": {
        "name": "opd_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "example": 20
        },
        "description": "ID perangkat daerah."
      },
      "OpdIdQuery": {
        "name": "opd_id",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer",
          "example": 20
        },
        "description": "ID perangkat daerah."
      },
      "Periode": {
        "name": "periode",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{4}$",
          "example": "2025-2029"
        },
        "description": "Filter periode dalam format YYYY-YYYY."
      },
      "TahunMulai": {
        "name": "tahun_mulai",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "example": 2025
        },
        "description": "Alternatif filter tahun awal periode."
      },
      "TahunAkhir": {
        "name": "tahun_akhir",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "example": 2029
        },
        "description": "Alternatif filter tahun akhir periode."
      },
      "StatusIku": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": ["all", "selesai", "draft", "belum", "tercapai"],
          "default": "selesai"
        },
        "description": "Filter status IKU. Default hanya menampilkan IKU dengan status selesai."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Parameter tidak valid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "API token tidak valid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Data tidak ditemukan",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "API token tidak valid."
          }
        }
      },
      "Opd": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 20
          },
          "nama_opd": {
            "type": "string",
            "example": "DINAS KOMUNIKASI DAN INFORMATIKA"
          },
          "singkatan": {
            "type": "string",
            "nullable": true,
            "example": "DISKOMINFO"
          }
        }
      },
      "Period": {
        "type": "object",
        "properties": {
          "periode": {
            "type": "string",
            "example": "2025-2029"
          },
          "tahun_mulai": {
            "type": "integer",
            "example": 2025
          },
          "tahun_akhir": {
            "type": "integer",
            "example": 2029
          },
          "years": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "example": [2025, 2026, 2027, 2028, 2029]
          }
        }
      },
      "OpdListResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "meta": {
            "type": "object"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Opd"
            }
          }
        }
      },
      "OpdResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "meta": {
            "type": "object"
          },
          "data": {
            "$ref": "#/components/schemas/Opd"
          }
        }
      },
      "Iku": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 52
          },
          "renstra_id": {
            "type": "integer",
            "example": 126
          },
          "definisi": {
            "type": "string"
          },
          "rumusan_perhitungan": {
            "type": "string",
            "nullable": true
          },
          "sumber_data": {
            "type": "string",
            "nullable": true
          },
          "penanggung_jawab": {
            "type": "string",
            "nullable": true
          },
          "jenis_indikator": {
            "type": "string",
            "nullable": true,
            "description": "Jenis indikator seperti yang tampil di web (mis. maksimasi/minimasi)."
          },
          "baseline": {
            "type": "string",
            "nullable": true,
            "description": "Kondisi awal indikator."
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "opd": {
            "$ref": "#/components/schemas/Opd"
          },
          "sasaran": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "nama": {
                "type": "string"
              },
              "urutan": {
                "type": "integer",
                "nullable": true,
                "description": "Urutan tampil sasaran pada tabel web."
              }
            }
          },
          "indikator": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "nama": {
                "type": "string"
              },
              "satuan": {
                "type": "string",
                "nullable": true,
                "description": "Nama satuan siap tampil (sudah di-resolve dari master satuan bila berupa id)."
              },
              "satuan_id": {
                "type": "integer",
                "nullable": true,
                "description": "Id master satuan; null bila satuan diketik manual."
              },
              "jenis_indikator": {
                "type": "string",
                "nullable": true
              },
              "baseline": {
                "type": "string",
                "nullable": true
              },
              "urutan": {
                "type": "integer",
                "nullable": true
              }
            }
          },
          "periode": {
            "type": "object",
            "properties": {
              "periode": {
                "type": "string",
                "example": "2025-2029"
              },
              "tahun_mulai": {
                "type": "integer"
              },
              "tahun_akhir": {
                "type": "integer"
              }
            }
          },
          "target_tahunan": {
            "type": "object",
            "description": "Berisi seluruh tahun pada meta.years; tahun tanpa target bernilai null (padanan tanda '-' di tabel web).",
            "additionalProperties": {
              "type": "string",
              "nullable": true
            },
            "example": {
              "2025": "3,05",
              "2026": "3,3",
              "2027": null
            }
          },
          "program_pendukung": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "program": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "IkuListResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "meta": {
            "type": "object",
            "properties": {
              "opd": {
                "$ref": "#/components/schemas/Opd"
              },
              "periode": {
                "type": "object",
                "nullable": true
              },
              "available_periods": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "years": {
                "type": "array",
                "description": "Kolom tahun tabel IKU di web. Seluruh tahun periode bila periode diketahui, selain itu gabungan tahun yang punya target.",
                "items": {
                  "type": "integer"
                },
                "example": [2025, 2026, 2027, 2028, 2029]
              },
              "status_filter": {
                "type": "string"
              },
              "count": {
                "type": "integer"
              }
            },
            "additionalProperties": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Iku"
            }
          }
        }
      },
      "CascadingRow": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "tujuan_id": {
            "type": "integer",
            "nullable": true
          },
          "tujuan_rpjmd": {
            "type": "string",
            "nullable": true
          },
          "sasaran_id": {
            "type": "integer",
            "nullable": true
          },
          "sasaran_rpjmd": {
            "type": "string",
            "nullable": true
          },
          "renstra_tujuan_id": {
            "type": "integer",
            "nullable": true
          },
          "renstra_tujuan": {
            "type": "string",
            "nullable": true
          },
          "indikator_tujuan_id": {
            "type": "integer",
            "nullable": true
          },
          "indikator_tujuan": {
            "type": "string",
            "nullable": true
          },
          "renstra_sasaran_id": {
            "type": "integer",
            "nullable": true
          },
          "renstra_sasaran": {
            "type": "string",
            "nullable": true
          },
          "indikator_id": {
            "type": "integer",
            "nullable": true
          },
          "indikator_sasaran": {
            "type": "string",
            "nullable": true
          },
          "satuan": {
            "type": "string",
            "nullable": true,
            "description": "Nilai mentah: id master satuan atau teks bebas."
          },
          "satuan_nama": {
            "type": "string",
            "nullable": true,
            "description": "Nama satuan siap tampil, hasil resolve dari master satuan."
          },
          "csf_es2": {
            "type": "string",
            "nullable": true
          },
          "es3_id": {
            "type": "integer",
            "nullable": true
          },
          "es3_sasaran": {
            "type": "string",
            "nullable": true
          },
          "es3_indikator_id": {
            "type": "integer",
            "nullable": true
          },
          "es3_indikator": {
            "type": "string",
            "nullable": true
          },
          "csf_es3": {
            "type": "string",
            "nullable": true
          },
          "es4_id": {
            "type": "integer",
            "nullable": true
          },
          "es4_sasaran": {
            "type": "string",
            "nullable": true
          },
          "es4_indikator_id": {
            "type": "integer",
            "nullable": true
          },
          "es4_indikator": {
            "type": "string",
            "nullable": true
          },
          "csf_es4": {
            "type": "string",
            "nullable": true
          },
          "pelaksana_id": {
            "type": "integer",
            "nullable": true,
            "description": "Jenjang Pelaksana/JF, jenjang terakhir di bawah Eselon IV."
          },
          "pelaksana_sasaran": {
            "type": "string",
            "nullable": true
          },
          "pelaksana_indikator_id": {
            "type": "integer",
            "nullable": true
          },
          "pelaksana_indikator": {
            "type": "string",
            "nullable": true
          },
          "csf_pelaksana": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CascadingResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "meta": {
            "type": "object"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CascadingRow"
            }
          }
        }
      },
      "PohonNode": {
        "type": "object",
        "additionalProperties": true,
        "description": "Simpul akar pohon (Tujuan RPJMD). Rantai jenjangnya mengikuti tampilan web: sasaran -> tujuan_renstra -> es2 -> es3 -> es4 -> pelaksana, masing-masing punya array `indikator` dan (mulai es2) properti `csf`.",
        "properties": {
          "id": {
            "type": "integer",
            "nullable": true
          },
          "nama": {
            "type": "string"
          },
          "sasaran": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "PohonKinerjaResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "meta": {
            "type": "object"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PohonNode"
            }
          }
        }
      }
    }
  }
}

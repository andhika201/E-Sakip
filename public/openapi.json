{
  "openapi": "3.0.3",
  "info": {
    "title": "API e-SAKIP Kabupaten Pringsewu",
    "version": "1.0.0",
    "description": "API read-only untuk perangkat daerah, IKU, cascading, pohon kinerja, serta Target & Rencana Aksi (turunan Perjanjian Kinerja)."
  },
  "servers": [
    {
      "url": "/",
      "description": "Server aplikasi saat ini"
    }
  ],
  "security": [
    {
      "ApiToken": []
    }
  ],
  "tags": [
    {
      "name": "Perangkat Daerah"
    },
    {
      "name": "IKU"
    },
    {
      "name": "Cascading"
    },
    {
      "name": "Pohon Kinerja"
    },
    {
      "name": "Target & Rencana Aksi"
    }
  ],
  "paths": {
    "/api/perangkat-daerah": {
      "get": {
        "tags": ["Perangkat Daerah"],
        "summary": "Daftar perangkat daerah",
        "responses": {
          "200": {
            "description": "Daftar perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpdListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/perangkat-daerah/{opd_id}": {
      "get": {
        "tags": ["Perangkat Daerah"],
        "summary": "Detail perangkat daerah",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Detail perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpdResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/perangkat-daerah/{opd_id}/iku": {
      "get": {
        "tags": ["IKU"],
        "summary": "IKU perangkat daerah",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdPath"
          },
          {
            "$ref": "#/components/parameters/Periode"
          },
          {
            "$ref": "#/components/parameters/TahunMulai"
          },
          {
            "$ref": "#/components/parameters/TahunAkhir"
          },
          {
            "$ref": "#/components/parameters/StatusIku"
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar IKU perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IkuListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/perangkat-daerah/{opd_id}/cascading": {
      "get": {
        "tags": ["Cascading"],
        "summary": "Cascading perangkat daerah",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdPath"
          },
          {
            "$ref": "#/components/parameters/Periode"
          },
          {
            "$ref": "#/components/parameters/TahunMulai"
          },
          {
            "$ref": "#/components/parameters/TahunAkhir"
          }
        ],
        "responses": {
          "200": {
            "description": "Matriks cascading perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CascadingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/perangkat-daerah/{opd_id}/pohon-kinerja": {
      "get": {
        "tags": ["Pohon Kinerja"],
        "summary": "Pohon kinerja perangkat daerah",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdPath"
          },
          {
            "$ref": "#/components/parameters/Periode"
          },
          {
            "$ref": "#/components/parameters/TahunMulai"
          },
          {
            "$ref": "#/components/parameters/TahunAkhir"
          }
        ],
        "responses": {
          "200": {
            "description": "Tree pohon kinerja perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PohonKinerjaResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/iku": {
      "get": {
        "tags": ["IKU"],
        "summary": "IKU perangkat daerah menggunakan query opd_id",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdQuery"
          },
          {
            "$ref": "#/components/parameters/Periode"
          },
          {
            "$ref": "#/components/parameters/TahunMulai"
          },
          {
            "$ref": "#/components/parameters/TahunAkhir"
          },
          {
            "$ref": "#/components/parameters/StatusIku"
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar IKU perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IkuListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/cascading": {
      "get": {
        "tags": ["Cascading"],
        "summary": "Cascading perangkat daerah menggunakan query opd_id",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdQuery"
          },
          {
            "$ref": "#/components/parameters/Periode"
          },
          {
            "$ref": "#/components/parameters/TahunMulai"
          },
          {
            "$ref": "#/components/parameters/TahunAkhir"
          }
        ],
        "responses": {
          "200": {
            "description": "Matriks cascading perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CascadingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/pohon-kinerja": {
      "get": {
        "tags": ["Pohon Kinerja"],
        "summary": "Pohon kinerja perangkat daerah menggunakan query opd_id",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdQuery"
          },
          {
            "$ref": "#/components/parameters/Periode"
          },
          {
            "$ref": "#/components/parameters/TahunMulai"
          },
          {
            "$ref": "#/components/parameters/TahunAkhir"
          }
        ],
        "responses": {
          "200": {
            "description": "Tree pohon kinerja perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PohonKinerjaResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/perangkat-daerah/{opd_id}/target-renaksi": {
      "get": {
        "tags": ["Target & Rencana Aksi"],
        "summary": "Target & Rencana Aksi perangkat daerah",
        "description": "Sama dengan tabel Target dan Rencana Aksi PK OPD/Kecamatan di web (Eselon II/III/IV): Sasaran > Indikator > unit anggaran > Rencana Aksi > Sub Rencana Aksi > Target Triwulan I-IV > Penanggung Jawab. Data dikelompokkan per Sasaran PK, meniru penggabungan baris pada kolom \"No\".",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdPath"
          },
          {
            "$ref": "#/components/parameters/TahunPk"
          },
          {
            "$ref": "#/components/parameters/EselonPk"
          },
          {
            "$ref": "#/components/parameters/PejabatPk"
          }
        ],
        "responses": {
          "200": {
            "description": "Target & Rencana Aksi perangkat daerah",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TargetRenaksiResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/target-renaksi": {
      "get": {
        "tags": ["Target & Rencana Aksi"],
        "summary": "Target & Rencana Aksi PK OPD/Kecamatan",
        "description": "Sama dengan tabel Target dan Rencana Aksi PK OPD/Kecamatan di web (Eselon II/III/IV): Sasaran > Indikator > unit anggaran > Rencana Aksi > Sub Rencana Aksi > Target Triwulan I-IV > Penanggung Jawab. Data dikelompokkan per Sasaran PK, meniru penggabungan baris pada kolom \"No\". Tanpa `opd_id`, hasilnya lintas perangkat daerah.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OpdIdQueryOpsional"
          },
          {
            "$ref": "#/components/parameters/TahunPk"
          },
          {
            "$ref": "#/components/parameters/EselonPk"
          },
          {
            "$ref": "#/components/parameters/PejabatPk"
          }
        ],
        "responses": {
          "200": {
            "description": "Target & Rencana Aksi PK OPD/Kecamatan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TargetRenaksiResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/target-renaksi/bupati": {
      "get": {
        "tags": ["Target & Rencana Aksi"],
        "summary": "Target & Rencana Aksi PK Bupati",
        "description": "Sama dengan tabel Target dan Rencana Aksi PK Bupati di web, yang memang hanya menampilkan Sasaran, Indikator, Tahun, Satuan, Target, dan Perangkat Daerah Pendukung.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TahunPk"
          }
        ],
        "responses": {
          "200": {
            "description": "Target & Rencana Aksi PK Bupati",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TargetRenaksiBupatiResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiToken": {
        "type": "apiKey",
        "in": "header",
        "name": "api-token",
        "description": "Masukkan token API dari file .env."
      }
    },
    "parameters": {
      "OpdIdPath": {
        "name": "opd_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "example": 20
        },
        "description": "ID perangkat daerah."
      },
      "OpdIdQuery": {
        "name": "opd_id",
        "in": "query",
        "required": true,
        "schema": {
          "type": "integer",
          "example": 20
        },
        "description": "ID perangkat daerah."
      },
      "Periode": {
        "name": "periode",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{4}$",
          "example": "2025-2029"
        },
        "description": "Filter periode dalam format YYYY-YYYY."
      },
      "TahunMulai": {
        "name": "tahun_mulai",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "example": 2025
        },
        "description": "Alternatif filter tahun awal periode."
      },
      "TahunAkhir": {
        "name": "tahun_akhir",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "example": 2029
        },
        "description": "Alternatif filter tahun akhir periode."
      },
      "StatusIku": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": ["all", "selesai", "draft", "belum", "tercapai"],
          "default": "selesai"
        },
        "description": "Filter status IKU. Default hanya menampilkan IKU dengan status selesai."
      },
      "TahunPk": {
        "name": "tahun",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^(\\d{4}|all)$",
          "example": "2026"
        },
        "description": "Filter tahun Perjanjian Kinerja. Kosong atau `all` = semua tahun."
      },
      "OpdIdQueryOpsional": {
        "name": "opd_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "example": 20
        },
        "description": "Batasi pada satu perangkat daerah. Kosong = lintas OPD."
      },
      "EselonPk": {
        "name": "eselon",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": ["jpt", "administrator", "camat", "kecamatan", "pengawas"],
          "example": "jpt"
        },
        "description": "Filter jenjang PK: `jpt` (Eselon II), `administrator` (Eselon III, alias `camat`/`kecamatan`), `pengawas` (Eselon IV). Kosong = semua jenjang."
      },
      "PejabatPk": {
        "name": "pejabat_id",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "example": 151
        },
        "description": "Filter pejabat penandatangan PK (`pk.pihak_1`)."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Parameter tidak valid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "API token tidak valid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Data tidak ditemukan",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "API token tidak valid."
          }
        }
      },
      "Opd": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 20
          },
          "nama_opd": {
            "type": "string",
            "example": "DINAS KOMUNIKASI DAN INFORMATIKA"
          },
          "singkatan": {
            "type": "string",
            "nullable": true,
            "example": "DISKOMINFO"
          }
        }
      },
      "Period": {
        "type": "object",
        "properties": {
          "periode": {
            "type": "string",
            "example": "2025-2029"
          },
          "tahun_mulai": {
            "type": "integer",
            "example": 2025
          },
          "tahun_akhir": {
            "type": "integer",
            "example": 2029
          },
          "years": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "example": [2025, 2026, 2027, 2028, 2029]
          }
        }
      },
      "OpdListResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "meta": {
            "type": "object"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Opd"
            }
          }
        }
      },
      "OpdResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "meta": {
            "type": "object"
          },
          "data": {
            "$ref": "#/components/schemas/Opd"
          }
        }
      },
      "Iku": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 52
          },
          "renstra_id": {
            "type": "integer",
            "example": 126
          },
          "definisi": {
            "type": "string"
          },
          "rumusan_perhitungan": {
            "type": "string",
            "nullable": true
          },
          "sumber_data": {
            "type": "string",
            "nullable": true
          },
          "penanggung_jawab": {
            "type": "string",
            "nullable": true
          },
          "jenis_indikator": {
            "type": "string",
            "nullable": true,
            "description": "Jenis indikator seperti yang tampil di web (mis. maksimasi/minimasi)."
          },
          "baseline": {
            "type": "string",
            "nullable": true,
            "description": "Kondisi awal indikator."
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "opd": {
            "$ref": "#/components/schemas/Opd"
          },
          "sasaran": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "nama": {
                "type": "string"
              },
              "urutan": {
                "type": "integer",
                "nullable": true,
                "description": "Urutan tampil sasaran pada tabel web."
              }
            }
          },
          "indikator": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "nama": {
                "type": "string"
              },
              "satuan": {
                "type": "string",
                "nullable": true,
                "description": "Nama satuan siap tampil (sudah di-resolve dari master satuan bila berupa id)."
              },
              "satuan_id": {
                "type": "integer",
                "nullable": true,
                "description": "Id master satuan; null bila satuan diketik manual."
              },
              "jenis_indikator": {
                "type": "string",
                "nullable": true
              },
              "baseline": {
                "type": "string",
                "nullable": true
              },
              "urutan": {
                "type": "integer",
                "nullable": true
              }
            }
          },
          "periode": {
            "type": "object",
            "properties": {
              "periode": {
                "type": "string",
                "example": "2025-2029"
              },
              "tahun_mulai": {
                "type": "integer"
              },
              "tahun_akhir": {
                "type": "integer"
              }
            }
          },
          "target_tahunan": {
            "type": "object",
            "description": "Berisi seluruh tahun pada meta.years; tahun tanpa target bernilai null (padanan tanda '-' di tabel web).",
            "additionalProperties": {
              "type": "string",
              "nullable": true
            },
            "example": {
              "2025": "3,05",
              "2026": "3,3",
              "2027": null
            }
          },
          "program_pendukung": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "program": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "IkuListResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "meta": {
            "type": "object",
            "properties": {
              "opd": {
                "$ref": "#/components/schemas/Opd"
              },
              "periode": {
                "type": "object",
                "nullable": true
              },
              "available_periods": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "years": {
                "type": "array",
                "description": "Kolom tahun tabel IKU di web. Seluruh tahun periode bila periode diketahui, selain itu gabungan tahun yang punya target.",
                "items": {
                  "type": "integer"
                },
                "example": [2025, 2026, 2027, 2028, 2029]
              },
              "status_filter": {
                "type": "string"
              },
              "count": {
                "type": "integer"
              }
            },
            "additionalProperties": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Iku"
            }
          }
        }
      },
      "CascadingRow": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "tujuan_id": {
            "type": "integer",
            "nullable": true
          },
          "tujuan_rpjmd": {
            "type": "string",
            "nullable": true
          },
          "sasaran_id": {
            "type": "integer",
            "nullable": true
          },
          "sasaran_rpjmd": {
            "type": "string",
            "nullable": true
          },
          "renstra_tujuan_id": {
            "type": "integer",
            "nullable": true
          },
          "renstra_tujuan": {
            "type": "string",
            "nullable": true
          },
          "indikator_tujuan_id": {
            "type": "integer",
            "nullable": true
          },
          "indikator_tujuan": {
            "type": "string",
            "nullable": true
          },
          "renstra_sasaran_id": {
            "type": "integer",
